NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=fairride
DATABASE_PASSWORD=local_only_change_me
DATABASE_NAME=fairride

REDIS_PASSWORD=local_only_redis_change_me
REDIS_URL=redis://:local_only_redis_change_me@localhost:6379

# Replace this before starting the API. Generate a local secret, for example:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

TRUST_PROXY_HOPS=0
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_REGISTER_LIMIT=5

DRIVER_LOCATION_MAX_AGE_SECONDS=120
DRIVER_MATCH_RADIUS_METERS=4000
DRIVER_MATCH_LIMIT=5
RIDE_OFFER_TTL_SECONDS=45

FARE_BASE_PAISA=15000
FARE_PER_KM_PAISA=3500
FARE_PER_MINUTE_PAISA=500
FARE_MINIMUM_PAISA=20000

# development uses a marked straight-line estimate. Production requires a
# managed or self-hosted OSRM-compatible service; public endpoints are not set.
ROUTING_PROVIDER=development
ROUTING_BASE_URL=

# Development only: allow the OTP endpoint to return its one-time code locally.
OTP_DEV_RETURN_CODE=false
OTP_CODE_TTL_SECONDS=300

# Provide these only for the explicit one-time super-admin bootstrap command.
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_PHONE=
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
